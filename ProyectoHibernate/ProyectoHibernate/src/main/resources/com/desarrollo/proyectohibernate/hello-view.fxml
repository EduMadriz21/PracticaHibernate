<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.desarrollo.proyectohibernate.HelloController"
      spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Catálogo de Libros (Hibernate + PostgreSQL)" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <Label text="Título:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitulo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Autor:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAutor" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Año publicación:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAnio" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Precio:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrecio" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Guardar libro" onAction="#guardarLibro"/>
        <Button text="Modificar libro" onAction="#modificarLibro"/>
        <Button text="Eliminar libro" onAction="#eliminarLibro"/>
        <Button text="Limpiar campos" onAction="#limpiarCampos"/>
    </HBox>

    <Label fx:id="lblMensaje"/>

    <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="220"/>
            <TableColumn fx:id="colAutor" text="Autor" prefWidth="170"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="80"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90"/>
        </columns>
    </TableView>
</VBox>
